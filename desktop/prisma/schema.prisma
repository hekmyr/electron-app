
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  firstName String
  lastName  String
  email     String     @unique
  phone     String
  address   String
  city      String
  state     String
  zip       String
  packages  Package[]
  deliveries Delivery[]
}

model Package {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  weight      Float
  length      Float
  width       Float
  height      Float
  status      String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id])
}

model Delivery {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  status     String
  driverId   String
  driver     Driver     @relation(fields: [driverId], references: [id])
  packages   Package[]
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
}

model Driver {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  firstName  String
  lastName   String
  email      String     @unique
  phone      String
  deliveries Delivery[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String
  role      String // "user" or "bot"
}
